from collections import deque


############ INPUT ############
n, m = map(int, input().split())
grid = []
ax,ay = 0,0 # initializing a 

for r in range(n):
    currRow = input()
    formattedRow = [] 

    for c in range(m):
        currCell = currRow[c]
        if currCell == "A":
            ax = r # yes, x is vertical
            ay = c
        formattedRow.append(currCell)

    grid.append(formattedRow)

############ HELPERS ############
dy = [0, 0, -1, 1]
dx = [-1, 1, 0, 0]

def neighbors(v):
    vx, vy = v
    ans = []
    for i in range(4):
        newCoords = ( vx+dx[i], vy+dy[i] )
        ans.append(newCoords)
    return ans

def whichDir(i):
    ans = ""
    if i==0:
        ans = "U"
    elif i==1:
        ans = "D"
    elif i==2:
        ans = "L"
    else:
        ans = "R"
    
    return ans

def goodPrint(a):
    for r in a:
        print(r)

############ BFS ############
def findPath():
    bestPath = ""
    bestLen = 1000*1000
    work = deque()
    seen = [ [False] * m for i in range(n) ]
    done = [ [False] * m for i in range(n) ]
    seen[ax][ay] = True

    work.append( ( (ax,ay) , "" ) )

    while work:
        currNode, currPath = work.pop()
        ns = neighbors(currNode)
        
        # print(f"curr is {currNode}, or {grid[currNode[0]][currNode[1]]}, with path {currPath}")
        # print(f"neighbors are {ns}")
        # print(f"seen is ")
        # goodPrint(seen)

        for i in range(4):
            cnx, cny = ns[i]
            
            if cnx<0 or cny<0 or cnx>=n or cny>=m or seen[cnx][cny]:
                continue

            nChar = grid[cnx][cny]
            dir = whichDir(i)

            # print(f"now checking {dir}, which is {nChar} at {(cnx,cny)}")

            if len(currPath) >= bestLen:
                break

            if nChar=="B":
                newPath = currPath + dir
                newLen = len(newPath) 

                # print(f"newfound path is {currPath}")

                if newLen < bestLen:
                    bestLen = newLen
                    bestPath = newPath
            elif nChar==".":
                newPath = currPath + dir
                toVisit = ( (cnx, cny) , newPath )

                # print(f"now appending {toVisit}")

                seen[cnx][cny] = True

                work.append(toVisit)

            # print(f"work so far is {work} \n")
            # print(f"best path so far is {bestPath} \n")

    return bestPath

ans = "NO"
shortest = findPath()

if len(shortest) != 0:
    shortest = findPath()
    ans = f"YES \n{len(shortest)} \n{shortest}"

print(ans)